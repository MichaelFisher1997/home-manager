#!/usr/bin/env bash
# Weather popup controller - toggle/hide

DIR="$(dirname "$(realpath "$0")")"
EWW_CONFIG_DIR="${EWW_CONFIG_DIR:-$(realpath "$DIR/..")}" 
LOCK_FILE="/tmp/eww_weather.lock"
TIMER_TOKEN_FILE="/tmp/eww_weather_timer.token"

monitor_index() {
    if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
        hyprctl -j monitors 2>/dev/null | jq -r 'to_entries[] | select(.value.focused == true) | .key' | head -n1
    fi
}

eww_cmd() {
    eww --config "$EWW_CONFIG_DIR" "$@"
}

popup_is_open() {
    eww_cmd active-windows 2>/dev/null | grep -q '^weather_popup:'
}

show_weather() {
    if ! popup_is_open; then
      touch "$LOCK_FILE"
      rm -f "$TIMER_TOKEN_FILE"
      screen="$(monitor_index)"
      screen="${screen:-0}"
      (
        eww_cmd open weather_popup --screen "$screen" 2>/dev/null
      ) >/dev/null 2>&1 &
  fi
}

hide_weather() {
  [ ! -f "$LOCK_FILE" ] && return
  rm -f "$TIMER_TOKEN_FILE"
  rm -f "$LOCK_FILE"
  eww_cmd close weather_catcher 2>/dev/null
  eww_cmd close weather_popup 2>/dev/null
}

toggle_weather() {
  if popup_is_open; then
    hide_weather
  else
    rm -f "$LOCK_FILE"
    show_weather
  fi
}

start_timer() {
  local token
  token="$(date +%s%N)"
  printf '%s\n' "$token" > "$TIMER_TOKEN_FILE"
  (
    sleep 4
    if [ -f "$LOCK_FILE" ] && [ "$(cat "$TIMER_TOKEN_FILE" 2>/dev/null)" = "$token" ]; then
      hide_weather
    fi
  ) &
}

cancel_timer() {
  rm -f "$TIMER_TOKEN_FILE"
}

case "$1" in
  toggle)      toggle_weather ;;
  hide)        hide_weather ;;
  start_timer) start_timer ;;
  cancel_timer) cancel_timer ;;
esac
